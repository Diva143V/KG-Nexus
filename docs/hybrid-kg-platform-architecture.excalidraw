   "updated": 1759248000000,
   "link": null,
   "locked": false,
   "text": "KEY ARCHITECTURAL RISKS",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "el0350",
   "type": "rectangle",
   "x": 60,
   "y": 13420,
   "width": 620,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 3771650,
