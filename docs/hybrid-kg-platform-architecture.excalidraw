    }
   ],
   "updated": 1759248000000,
   "link": null,
   "locked": false
  },
  {
   "id": "el0361",
   "type": "text",
   "x": 732,
   "y": 13848,
   "width": 596,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
