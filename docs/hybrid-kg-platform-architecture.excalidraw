   "roundness": null,
   "seed": 3842921,
   "version": 1,
   "versionNonce": 39597711,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1759248000000,
   "link": null,
   "locked": false,
   "text": "H4 — SECURITY BOUNDARY NOT FULLY OBSERVABLE\n\nSecurity / licensing testing exists, but authentication and authorization mechanisms are not established by the Graphify export.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el0358",
   "lineHeight": 1.25
  },
  {
   "id": "el0360",
   "type": "rectangle",
   "x": 720,
   "y": 13840,
   "width": 620,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffd43b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 3850840,
   "version": 1,
   "versionNonce": 39702440,
   "isDeleted": false,
   "boundElements": [
    {
     "id": "el0361",
