   "versionNonce": 39178795,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1759248000000,
   "link": null,
   "locked": false,
   "text": "H2 — RELEASE PIPELINE CENTRALIZATION\n\nrelease/pipeline.py degree = 41. EndToEndReleasePipeline degree = 29. Potential architectural choke point.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el0354",
   "lineHeight": 1.25
  },
  {
   "id": "el0356",
   "type": "rectangle",
   "x": 720,
   "y": 13630,
   "width": 620,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffe8cc",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 3819164,
   "version": 1,
   "versionNonce": 39283524,
   "isDeleted": false,
   "boundElements": [
    {
     "id": "el0357",
     "type": "text"
    }
   ],
   "updated": 1759248000000,
   "link": null,
   "locked": false
  },
  {
   "id": "el0357",
   "type": "text",
   "x": 732,
   "y": 13638,
   "width": 596,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
