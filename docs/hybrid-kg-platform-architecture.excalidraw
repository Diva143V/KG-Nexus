   "roundness": null,
   "seed": 3827083,
   "version": 1,
   "versionNonce": 39388253,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1759248000000,
   "link": null,
   "locked": false,
   "text": "H3 — PROJECTION DRIFT / OPERATIONAL STATE\n\nNeo4j + Search + Vector + Parquet + RDF create multiple materialized representations. Need versioning, idempotency, rollback, consistency checks and canonical-source guarantees.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el0356",
   "lineHeight": 1.25
  },
  {
   "id": "el0358",
   "type": "rectangle",
   "x": 60,
   "y": 13840,
   "width": 620,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffe8cc",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 3835002,
   "version": 1,
   "versionNonce": 39492982,
   "isDeleted": false,
   "boundElements": [
    {
     "id": "el0359",
     "type": "text"
    }
   ],
   "updated": 1759248000000,
   "link": null,
   "locked": false
  },
  {
   "id": "el0359",
   "type": "text",
   "x": 72,
   "y": 13848,
   "width": 596,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
