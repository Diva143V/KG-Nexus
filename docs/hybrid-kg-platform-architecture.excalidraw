   "roundness": null,
   "seed": 3795407,
   "version": 1,
   "versionNonce": 38969337,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1759248000000,
   "link": null,
   "locked": false,
   "text": "H1 — IDENTIFIER COUPLING HOTSPOT\n\nIdentifier degree = 71. Changes may ripple through normalization, matching, provenance, validation, release and API.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el0352",
   "lineHeight": 1.25
  },
  {
   "id": "el0354",
   "type": "rectangle",
   "x": 60,
   "y": 13630,
   "width": 620,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffe8cc",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 3803326,
   "version": 1,
