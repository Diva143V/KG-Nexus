   "link": null,
   "locked": false
  },
  {
   "id": "el0351",
   "type": "text",
   "x": 72,
   "y": 13428,
   "width": 596,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 3779569,
   "version": 1,
   "versionNonce": 38759879,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1759248000000,
   "link": null,
   "locked": false,
   "text": "C1 — GRAPH EXPORT LIMITATION\n\nGraphify export is aggregated and does not expose source-level relationships sufficiently for a source-code-certified architecture audit.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el0350",
   "lineHeight": 1.25
  },
  {
   "id": "el0352",
   "type": "rectangle",
   "x": 720,
   "y": 13420,
   "width": 620,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffe8cc",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 3787488,
   "version": 1,
   "versionNonce": 38864608,
   "isDeleted": false,
   "boundElements": [
    {
     "id": "el0353",
     "type": "text"
    }
   ],
   "updated": 1759248000000,
   "link": null,
   "locked": false
  },
  {
   "id": "el0353",
   "type": "text",
   "x": 732,
   "y": 13428,
   "width": 596,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
