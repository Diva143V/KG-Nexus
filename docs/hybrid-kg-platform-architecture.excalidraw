   "updated": 1759248000000,
   "link": null,
   "locked": false,
   "text": "DEPLOYMENT FACTS NOT CONFIRMED BY GRAPHIFY: Docker / Kubernetes / ECS / VM / Serverless / systemd / Reverse Proxy / Load Balancer / Cloud Provider / CI-CD",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
